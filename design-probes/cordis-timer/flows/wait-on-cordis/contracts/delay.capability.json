{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://probe.jig.dev/contracts/delay",
  "version": "1.0.0",
  "methods": {
    "wait": {
      "input": { "$ref": "#/$defs/WaitInput" },
      "output": { "$ref": "#/$defs/WaitOutput" },
      "errors": {}
    }
  },
  "$defs": {
    "WaitInput": {
      "type": "object",
      "properties": {
        "delayMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": ["delayMs"],
      "additionalProperties": false
    },
    "WaitOutput": {
      "type": "object",
      "properties": {
        "completed": { "const": true }
      },
      "required": ["completed"],
      "additionalProperties": false
    }
  }
}
