{
  "probeFormat": 1,
  "nonnormative": true,
  "flowSource": {
    "source": "./flows",
    "members": ["cordis-delay", "wait-on-cordis"]
  },
  "bindings": {
    "cordis-delay": {
      "kind": "package",
      "mode": "service-exact",
      "adapterSelector": "bun",
      "nativeRequirements": {
        "@flowmd/sdk": "^1.0.0",
        "cordis": "4.0.0-rc.8",
        "@cordisjs/plugin-timer": "1.1.2"
      },
      "settings": {},
      "exports": ["delay"]
    },
    "wait-on-cordis": {
      "kind": "package",
      "mode": "run-exact",
      "adapterSelector": "python3",
      "nativeRequirements": {
        "flowmd-sdk": ">=1,<2",
        "python": ">=3.13,<4"
      },
      "settings": {},
      "slots": {
        "delay": "cordis-delay#delay@<provider-generation>"
      }
    }
  }
}
