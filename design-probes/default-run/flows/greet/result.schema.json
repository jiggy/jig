{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "outcome": { "const": "done" },
    "output": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string",
          "minLength": 9,
          "maxLength": 136
        }
      },
      "required": ["greeting"],
      "additionalProperties": false
    }
  },
  "required": ["outcome", "output"],
  "additionalProperties": false
}
