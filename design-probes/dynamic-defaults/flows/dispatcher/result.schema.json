{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": { "const": "done" },
        "output": {
          "type": "object",
          "properties": {
            "value": { "type": "string", "maxLength": 65536 }
          },
          "required": ["value"],
          "additionalProperties": false
        }
      },
      "required": ["outcome", "output"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": { "const": "blocked" },
        "output": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": ["outcome", "output"],
      "additionalProperties": false
    }
  ]
}
