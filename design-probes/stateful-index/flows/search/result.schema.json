{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "outcome": { "const": "done" },
    "output": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "excerpt": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": ["documentId", "revision", "excerpt"],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": ["hits"],
      "additionalProperties": false
    }
  },
  "required": ["outcome", "output"],
  "additionalProperties": false
}
