{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "outcome": {
      "enum": ["done", "stale"]
    },
    "output": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "visibleRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "pendingEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "documentId",
        "expectedRevision",
        "visibleRevision",
        "documents",
        "pendingEvents"
      ],
      "additionalProperties": false
    }
  },
  "required": ["outcome", "output"],
  "additionalProperties": false
}
