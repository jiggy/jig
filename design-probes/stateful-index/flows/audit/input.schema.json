{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "title": "Committed document-indexed Event",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "journalPosition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "const": "https://probe.jig.dev/events/document-indexed"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "committedAtUnixMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "data": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["documentId", "revision"],
      "additionalProperties": false
    },
    "subject": {
      "type": "string",
      "maxLength": 2048
    },
    "occurredAtUnixMs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "causedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "eventId",
    "journalPosition",
    "type",
    "source",
    "committedAtUnixMs",
    "data"
  ],
  "additionalProperties": false
}
