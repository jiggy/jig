{
  "probeFormat": 1,
  "nonnormative": true,
  "flowAuthority": {
    "document-index": {
      "attachments": { "index": "read-write" },
      "effects": { "journal": ["append"] }
    },
    "ingest": { "effects": { "index": ["upsert"] } },
    "search": { "effects": { "index": ["get", "search", "stats"] } }
  },
  "applicationAuthority": {
    "server": {
      "rawNetwork": "127.0.0.1:4010 under user authority",
      "jigControl": ["run:start", "run:read", "run:cancel", "event:read"],
      "project": "this exact local project"
    },
    "browser": {
      "http": ["/api/documents", "/api/search", "/api/runs/:id", "/api/events"],
      "jigControl": []
    }
  },
  "deniedToFlows": [
    "raw-network",
    "journal-read",
    "jig-control",
    "browser-credential",
    "project-policy",
    ".jig"
  ]
}

