{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://probe.jig.dev/contracts/gui-document-index-read",
  "version": "1.0.0",
  "methods": {
    "search": {
      "input": { "$ref": "#/$defs/SearchInput" },
      "output": { "$ref": "#/$defs/SearchResult" },
      "errors": {}
    }
  },
  "$defs": {
    "DocumentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "SearchInput": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["query", "limit"],
      "additionalProperties": false
    },
    "SearchHit": {
      "type": "object",
      "properties": {
        "documentId": { "$ref": "#/$defs/DocumentId" },
        "revision": { "$ref": "#/$defs/Revision" },
        "excerpt": { "type": "string", "maxLength": 4096 }
      },
      "required": ["documentId", "revision", "excerpt"],
      "additionalProperties": false
    },
    "SearchResult": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/SearchHit" },
          "maxItems": 100
        }
      },
      "required": ["hits"],
      "additionalProperties": false
    }
  }
}
