{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://probe.jig.dev/contracts/document-index-write",
  "version": "1.0.0",
  "methods": {
    "upsert": {
      "input": { "$ref": "#/$defs/UpsertInput" },
      "output": { "$ref": "#/$defs/DocumentRecord" },
      "errors": {
        "stale-revision": { "$ref": "#/$defs/RevisionError" },
        "revision-conflict": { "$ref": "#/$defs/RevisionError" }
      }
    }
  },
  "$defs": {
    "DocumentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "UpsertInput": {
      "type": "object",
      "properties": {
        "documentId": { "$ref": "#/$defs/DocumentId" },
        "revision": { "$ref": "#/$defs/Revision" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      },
      "required": ["documentId", "revision", "text"],
      "additionalProperties": false
    },
    "DocumentRecord": {
      "type": "object",
      "properties": {
        "documentId": { "$ref": "#/$defs/DocumentId" },
        "revision": { "$ref": "#/$defs/Revision" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      },
      "required": ["documentId", "revision", "text"],
      "additionalProperties": false
    },
    "RevisionError": {
      "type": "object",
      "properties": {
        "currentRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["currentRevision"],
      "additionalProperties": false
    }
  }
}
