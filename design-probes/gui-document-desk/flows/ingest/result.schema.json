{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "outcome": { "const": "done" },
    "output": {
      "type": "object",
      "properties": {
        "documentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "text": { "type": "string", "minLength": 1, "maxLength": 262144 }
      },
      "required": ["documentId", "revision", "text"],
      "additionalProperties": false
    }
  },
  "required": ["outcome", "output"],
  "additionalProperties": false
}

