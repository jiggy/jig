{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://jig.dev/contracts/agent-run",
  "version": "1.0.0",
  "methods": {
    "run": {
      "input": { "$ref": "#/$defs/RunInput" },
      "output": { "$ref": "#/$defs/AgentResult" },
      "errors": {}
    }
  },
  "$defs": {
    "RunInput": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "skills": { "$ref": "#/$defs/SkillNames" },
        "responseSchema": true
      },
      "required": ["instructions"],
      "additionalProperties": false
    },
    "SkillNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 64
    },
    "AgentResult": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": ["completed", "blocked", "limit"]
        },
        "text": {
          "type": "string",
          "maxLength": 8388608
        },
        "structured": true
      },
      "required": ["outcome", "text"],
      "additionalProperties": false
    }
  }
}
