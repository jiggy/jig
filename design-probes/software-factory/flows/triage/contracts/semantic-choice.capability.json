{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://jig.dev/contracts/semantic-choice",
  "version": "1.0.0",
  "methods": {
    "choose": {
      "input": { "$ref": "#/$defs/ChoiceRequest" },
      "output": { "$ref": "#/$defs/ChoiceResult" },
      "errors": {}
    }
  },
  "$defs": {
    "Candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": ["id", "description"],
      "additionalProperties": false
    },
    "ChoiceRequest": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "context": true,
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/Candidate" },
          "minItems": 2,
          "maxItems": 256
        }
      },
      "required": ["objective", "context", "candidates"],
      "additionalProperties": false
    },
    "Selected": {
      "type": "object",
      "properties": {
        "status": { "const": "selected" },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rationale": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "required": ["status", "candidateId"],
      "additionalProperties": false
    },
    "Abstained": {
      "type": "object",
      "properties": {
        "status": { "const": "abstain" },
        "rationale": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "ChoiceResult": {
      "oneOf": [
        { "$ref": "#/$defs/Selected" },
        { "$ref": "#/$defs/Abstained" }
      ]
    }
  }
}
