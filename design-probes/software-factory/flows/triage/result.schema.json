{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": { "const": "done" },
        "output": {
          "type": "object",
          "properties": {
            "cardId": {
              "type": "string",
              "minLength": 69,
              "maxLength": 69
            },
            "strategy": {
              "enum": ["gauntlet", "majority-vote"]
            },
            "evidence": {
              "type": "string",
              "maxLength": 8388608
            }
          },
          "required": ["cardId", "strategy", "evidence"],
          "additionalProperties": false
        }
      },
      "required": ["outcome", "output"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": { "const": "blocked" },
        "output": {
          "type": "object",
          "properties": {
            "cardId": {
              "type": "string",
              "minLength": 69,
              "maxLength": 69
            }
          },
          "required": ["cardId"],
          "additionalProperties": false
        }
      },
      "required": ["outcome", "output"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": { "const": "duplicate" },
        "output": {
          "type": "object",
          "properties": {
            "cardId": {
              "type": "string",
              "minLength": 69,
              "maxLength": 69
            },
            "stage": {
              "enum": [
                "triage",
                "research",
                "voting",
                "implementation",
                "review",
                "revision",
                "verification",
                "done",
                "blocked"
              ]
            }
          },
          "required": ["cardId", "stage"],
          "additionalProperties": false
        }
      },
      "required": ["outcome", "output"],
      "additionalProperties": false
    }
  ]
}
