{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://jig.dev/contracts/journal",
  "version": "1.0.0",
  "methods": {
    "append": {
      "input": { "$ref": "#/$defs/AppendInput" },
      "output": { "$ref": "#/$defs/Event" },
      "errors": {}
    }
  },
  "$defs": {
    "AppendInput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "data": true,
        "subject": {
          "type": "string",
          "maxLength": 2048
        },
        "occurredAtUnixMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["type", "data"],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "journalPosition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "committedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": true,
        "subject": {
          "type": "string",
          "maxLength": 2048
        },
        "occurredAtUnixMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "causedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "eventId",
        "journalPosition",
        "type",
        "source",
        "committedAtUnixMs",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
