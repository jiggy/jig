{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "outcome": { "const": "done" },
    "output": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": ["target", "criteria"],
      "additionalProperties": false
    }
  },
  "required": ["outcome", "output"],
  "additionalProperties": false
}
