{
  "probeFormat": 1,
  "nonnormative": true,
  "note": "Tabletop projection only. Exact package, Binding, contract, Adapter, toolchain, Backend, provider-generation, recipe, and candidate digests must be computed by a real host.",
  "hostMatrixPrecondition": "The @jigging/hooks-files stable-text source, @jigging/agent-acp Run export, and @jigging/semantic-choice ranker registration resolve exactly; Deno Service and Sley implementations each have one complete enforcing activation recipe.",
  "flowSource": {
    "source": "./flows",
    "members": [
      "create-missing-flow",
      "kanban",
      "reference-deep",
      "reference-fast",
      "triage"
    ]
  },
  "bindings": {
    "work-agent": {
      "kind": "host-capability",
      "providerRegistration": "@jigging/agent-acp#run",
      "contract": {
        "id": "https://jig.dev/contracts/agent-run",
        "version": "1.0.0",
        "digest": "sha256:ea66148b0ad15d5c060cb94b35fc7ce6ef8acbd5a764b70b92e89c8f11fc3715"
      },
      "export": "run",
      "attachments": {
        "workspace": "./workspace"
      },
      "toolEffectCeiling": [
        "attachment-files",
        "sandboxed-command"
      ]
    },
    "analysis-agent": {
      "kind": "host-capability",
      "providerRegistration": "@jigging/agent-acp#run",
      "contract": {
        "id": "https://jig.dev/contracts/agent-run",
        "version": "1.0.0",
        "digest": "sha256:ea66148b0ad15d5c060cb94b35fc7ce6ef8acbd5a764b70b92e89c8f11fc3715"
      },
      "export": "run",
      "attachments": {},
      "toolEffectCeiling": []
    },
    "repair-agent": {
      "kind": "host-capability",
      "providerRegistration": "@jigging/agent-acp#run",
      "contract": {
        "id": "https://jig.dev/contracts/agent-run",
        "version": "1.0.0",
        "digest": "sha256:ea66148b0ad15d5c060cb94b35fc7ce6ef8acbd5a764b70b92e89c8f11fc3715"
      },
      "export": "run",
      "attachments": {},
      "toolEffectCeiling": [
        "attachment-files",
        "sandboxed-command"
      ]
    },
    "semantic-choice": {
      "kind": "host-capability",
      "providerRegistration": "@jigging/semantic-choice#chooseViaAgent",
      "contract": {
        "id": "https://jig.dev/contracts/semantic-choice",
        "version": "1.0.0",
        "digest": "sha256:83767b89d02163d8a36c5e4f561d7c164135866a6bfdee1acd20f76370971e02"
      },
      "export": "choose",
      "slots": {
        "agent": "analysis-agent@<exact-admitted-revision>"
      }
    },
    "kanban": {
      "kind": "package",
      "package": "kanban@<exact-package-revision>",
      "mode": "service-exact",
      "implementationRoot": "flow.ts",
      "adapterSelector": "deno",
      "providerContracts": {
        "kanban": "contracts/kanban.capability.json@<derived-exact-triple>"
      },
      "attachments": {
        "board": "./kanban"
      },
      "readiness": "READY(<exact-pinned-recipe>)"
    },
    "triage": {
      "kind": "package",
      "package": "software-factory-triage@<exact-package-revision>",
      "mode": "run-exact",
      "implementationRoot": "flow.ts",
      "adapterSelector": "sley",
      "slots": {
        "worker": "work-agent@<exact-admitted-revision>",
        "analyst": "analysis-agent@<exact-admitted-revision>",
        "choice": "semantic-choice@<exact-admitted-revision>",
        "kanban": "kanban#kanban@<exact-export-generation>",
        "reference-research": {
          "kind": "candidate-set",
          "candidateSnapshot": [
            "reference-fast@<exact-admitted-revision>",
            "reference-deep@<exact-admitted-revision>"
          ]
        }
      },
      "attachments": {},
      "consumerContracts": {
        "worker": "contracts/agent-run.capability.json@<derived-exact-triple>",
        "analyst": "contracts/agent-run.capability.json@<derived-exact-triple>",
        "choice": "contracts/semantic-choice.capability.json@<derived-exact-triple>",
        "kanban": "contracts/kanban.capability.json@<derived-exact-triple>"
      },
      "skills": {
        "available": [
          "focused-coding",
          "focused-validation",
          "solution-design"
        ],
        "selection": "explicit per Agent Run; omitted means none"
      },
      "readiness": "READY(<exact-pinned-recipe>)"
    },
    "reference-fast": {
      "kind": "package",
      "package": "reference-fast@<exact-package-revision>",
      "mode": "run-instruction",
      "instructionAgent": "analysis-agent@<exact-admitted-revision>",
      "readiness": "READY(<exact-instruction-recipe>)"
    },
    "reference-deep": {
      "kind": "package",
      "package": "reference-deep@<exact-package-revision>",
      "mode": "run-instruction",
      "instructionAgent": "analysis-agent@<exact-admitted-revision>",
      "readiness": "READY(<exact-instruction-recipe>)"
    },
    "create-missing-flow": {
      "kind": "package",
      "package": "create-missing-flow@<exact-package-revision>",
      "mode": "run-instruction",
      "instructionAgent": "repair-agent@<exact-admitted-revision>",
      "attachments": {
        "workspace": "./repair-staging"
      },
      "readiness": "READY(<exact-instruction-recipe>)"
    }
  },
  "hook": {
    "id": "on-inbox-item",
    "sourceKind": "owned-host-event-source",
    "sourceRegistration": "@jigging/hooks-files#stableTextFiles",
    "sourceRevision": "<exact-admitted-source-revision>",
    "type": "https://jig.dev/events/stable-text-file",
    "sourceSettings": {
      "suffix": ".md",
      "settleMs": 250,
      "maxBytes": 1048576,
      "maxScalars": 262144
    },
    "sourceRoots": {
      "root": "read-only ./inbox"
    },
    "target": "triage@<exact-admitted-revision>",
    "journalInterval": "[<apply-boundary>, open)"
  },
  "semanticChoice": "semantic-choice@<exact-admitted-revision>",
  "localSleyRoute": {
    "owner": "triage package",
    "edgeIds": [
      "gauntlet",
      "majority-vote"
    ],
    "notResolverCandidates": true
  },
  "derivedAtPlanTime": [
    "complete captured project source closure and source memberships",
    "exact package, schema, contract, provider, Binding, and Hook identities",
    "one exact implementation recipe or exact unavailable reason per Binding",
    "ordered approved child-candidate snapshot for reference-research",
    "semantic and authority delta, candidate digest, base generation, and proposed initial lock"
  ]
}
