{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jig.dev/conformance/project-authoring-probe-1/evaluation.schema.json",
  "title": "Project Authoring Probe/1 evaluation record",
  "type": "object",
  "required": [
    "campaign",
    "format",
    "packetRoot",
    "submissionRoot",
    "status",
    "operationalJigHost",
    "gates",
    "commands",
    "surfaceUse",
    "observations",
    "publicAuthoringSufficient",
    "runtimeDependencyStory",
    "nonclaims"
  ],
  "properties": {
    "campaign": {
      "const": "project-authoring-probe-1"
    },
    "format": {
      "const": 1
    },
    "packetRoot": {
      "$ref": "#/$defs/digest"
    },
    "submissionRoot": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "operationalJigHost": {
      "const": false
    },
    "gates": {
      "type": "object",
      "required": [
        "packet-integrity",
        "submission-integrity",
        "static-tree",
        "typescript-typecheck",
        "python-compile-import",
        "normalizer-package-check",
        "reviewer-package-check",
        "schema-fixtures",
        "project-evaluation",
        "project-linking",
        "normalizer-run",
        "reviewer-run",
        "child-operational-failure",
        "child-deadline",
        "bounded-clean-shutdown"
      ],
      "properties": {
        "packet-integrity": {
          "$ref": "#/$defs/gate"
        },
        "submission-integrity": {
          "$ref": "#/$defs/gate"
        },
        "static-tree": {
          "$ref": "#/$defs/gate"
        },
        "typescript-typecheck": {
          "$ref": "#/$defs/gate"
        },
        "python-compile-import": {
          "$ref": "#/$defs/gate"
        },
        "normalizer-package-check": {
          "$ref": "#/$defs/gate"
        },
        "reviewer-package-check": {
          "$ref": "#/$defs/gate"
        },
        "schema-fixtures": {
          "$ref": "#/$defs/gate"
        },
        "project-evaluation": {
          "$ref": "#/$defs/gate"
        },
        "project-linking": {
          "$ref": "#/$defs/gate"
        },
        "normalizer-run": {
          "$ref": "#/$defs/gate"
        },
        "reviewer-run": {
          "$ref": "#/$defs/gate"
        },
        "child-operational-failure": {
          "$ref": "#/$defs/gate"
        },
        "child-deadline": {
          "$ref": "#/$defs/gate"
        },
        "bounded-clean-shutdown": {
          "$ref": "#/$defs/gate"
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "surfaceUse": {
      "type": "object",
      "required": [
        "author",
        "evaluator"
      ],
      "properties": {
        "author": {
          "$ref": "#/$defs/string-list"
        },
        "evaluator": {
          "$ref": "#/$defs/string-list"
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "ambiguities",
        "accidentalPlatformKnowledge",
        "workarounds",
        "missingInterfaces"
      ],
      "properties": {
        "ambiguities": {
          "$ref": "#/$defs/string-list"
        },
        "accidentalPlatformKnowledge": {
          "$ref": "#/$defs/string-list"
        },
        "workarounds": {
          "$ref": "#/$defs/string-list"
        },
        "missingInterfaces": {
          "$ref": "#/$defs/string-list"
        }
      },
      "additionalProperties": false
    },
    "publicAuthoringSufficient": {
      "enum": [
        "yes",
        "no",
        "unclear"
      ]
    },
    "runtimeDependencyStory": {
      "enum": [
        "clear",
        "unclear"
      ]
    },
    "nonclaims": {
      "type": "object",
      "required": [
        "operationalJigHost",
        "starterQuality",
        "agentConformance",
        "serviceConformance",
        "hookConformance",
        "semanticChoiceConformance",
        "generalOrchestrationConformance"
      ],
      "properties": {
        "operationalJigHost": {
          "const": false
        },
        "starterQuality": {
          "const": false
        },
        "agentConformance": {
          "const": false
        },
        "serviceConformance": {
          "const": false
        },
        "hookConformance": {
          "const": false
        },
        "semanticChoiceConformance": {
          "const": false
        },
        "generalOrchestrationConformance": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "string-list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not-run"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "id",
        "argv",
        "status",
        "exitCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed-out",
            "not-run"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdoutSha256": {
          "$ref": "#/$defs/digest"
        },
        "stderrSha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    }
  }
}
