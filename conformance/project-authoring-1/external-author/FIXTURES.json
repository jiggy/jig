{
  "campaign": "project-authoring-probe-1",
  "format": 1,
  "normalizer": {
    "input": {
      "valid": {
        "text": "  Build the smallest correct thing.  "
      },
      "invalid": [
        {},
        {
          "text": 7
        },
        {
          "text": "  Build the smallest correct thing.  ",
          "extra": true
        }
      ]
    },
    "settings": {
      "valid": {},
      "invalid": [
        {
          "prefix": "reviewed: "
        }
      ]
    },
    "result": {
      "valid": {
        "outcome": "done",
        "output": {
          "text": "Build the smallest correct thing."
        }
      },
      "invalid": [
        {
          "outcome": "done",
          "output": {}
        },
        {
          "outcome": "failed",
          "output": {
            "text": "Build the smallest correct thing."
          }
        },
        {
          "outcome": "done",
          "output": {
            "text": "Build the smallest correct thing.",
            "extra": true
          }
        }
      ]
    }
  },
  "reviewer": {
    "input": {
      "valid": {
        "text": "  Build the smallest correct thing.  "
      },
      "invalid": [
        {},
        {
          "text": false
        },
        {
          "text": "  Build the smallest correct thing.  ",
          "extra": null
        }
      ]
    },
    "settings": {
      "valid": {
        "prefix": "reviewed: "
      },
      "invalid": [
        {},
        {
          "prefix": 1
        },
        {
          "prefix": "reviewed: ",
          "extra": true
        }
      ]
    },
    "result": {
      "valid": {
        "outcome": "done",
        "output": {
          "label": "reviewed: Build the smallest correct thing.",
          "normalization": {
            "outcome": "done",
            "output": {
              "text": "Build the smallest correct thing."
            }
          }
        }
      },
      "invalid": [
        {
          "outcome": "done",
          "output": {
            "label": "reviewed: Build the smallest correct thing.",
            "normalization": {
              "text": "Build the smallest correct thing."
            }
          }
        },
        {
          "outcome": "done",
          "output": {
            "label": "Build the smallest correct thing.",
            "normalization": {
              "outcome": "done",
              "output": {
                "text": "Build the smallest correct thing."
              }
            }
          }
        },
        {
          "outcome": "done",
          "output": {
            "label": "reviewed: Build the smallest correct thing."
          }
        }
      ]
    },
    "flowCall": {
      "operationId": "normalize:1",
      "slot": "normalizer",
      "intent": "Normalize the text before producing the review label.",
      "input": {
        "text": "  Build the smallest correct thing.  "
      }
    }
  },
  "hostScenarios": {
    "childSuccess": {
      "reply": {
        "outcome": "done",
        "output": {
          "text": "Build the smallest correct thing."
        }
      },
      "expectedRoot": {
        "outcome": "done",
        "output": {
          "label": "reviewed: Build the smallest correct thing.",
          "normalization": {
            "outcome": "done",
            "output": {
              "text": "Build the smallest correct thing."
            }
          }
        }
      }
    },
    "childOperationalFailure": {
      "reply": {
        "jsonRpcCode": -32000,
        "message": "Injected child execution failure.",
        "data": {
          "code": "EXECUTION_FAILED",
          "details": {
            "fixture": "child-operational-failure"
          }
        }
      },
      "expectedRoot": {
        "kind": "operational-failure",
        "mustNotProduceDomainResult": true
      }
    },
    "childNeverReplies": {
      "hostAction": "admit the exact flow/call and withhold its response",
      "rootDeadlineAfterMs": 250,
      "processExitGraceMs": 1000,
      "expectedRootTerminal": "DEADLINE_EXCEEDED",
      "mustNotRedispatch": true
    },
    "cleanShutdown": {
      "rootResponseTimeoutMs": 2000,
      "processExitGraceMs": 1000,
      "trailingStdoutObservationMs": 100,
      "expectedTrailingFrames": 0
    }
  },
  "importAllowlist": {
    "project/jig.ts": [
      "@jigging/jig"
    ],
    "project/bindings/reviewer.ts": [
      "@jigging/jig"
    ],
    "project/flows/reviewer/flow.ts": [
      "@flowmd/sdk"
    ],
    "project/flows/normalizer/flow.py": [
      "flowmd_sdk"
    ],
    "allOtherProjectFiles": [],
    "dynamicImportsAllowed": false,
    "commonJsRequireAllowed": false,
    "relativeCodeImportsAllowed": false
  }
}
