# ---------------------------------------------------------------------------- #
#                                   COMMANDS                                   #
# ---------------------------------------------------------------------------- #

@default:
    just --list

# Compile the library and bundle the complete ordinary Flow runtime
@build:
    bun node_modules/typescript/bin/tsc -p tsconfig.json
    bun build src/flow.ts --target=node --format=esm --outfile=dist/flow.js

# Build, then pack a complete archive without installation hooks
[positional-arguments]
@pack *args: build
    bun scripts/pack.ts "$@"

# ---------------------------------------------------------------------------- #
#                                    CHECKS                                    #
# ---------------------------------------------------------------------------- #

[positional-arguments]
@test *args:
    bun test "$@"

check: build test
