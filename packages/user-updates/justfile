@default:
    just --list

@build:
    bun node_modules/typescript/bin/tsc -p tsconfig.json
    cp src/user-updates.json dist/user-updates.json
    cp LICENSE dist/LICENSE

[positional-arguments]
@test *args:
    bun test "$@"

check: build test

[positional-arguments]
@pack *args: build
    bun pm pack --ignore-scripts "$@"
