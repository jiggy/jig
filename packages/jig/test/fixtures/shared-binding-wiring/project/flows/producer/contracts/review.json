{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "id": "https://example.org/contracts/manuscript-review",
  "version": "0.1.0",
  "input": {
    "type": "object",
    "properties": {
      "scope": {
        "enum": ["chapter", "book"]
      },
      "purpose": {
        "enum": ["developmental", "post-edit"]
      },
      "text": {
        "type": "string"
      }
    },
    "required": ["scope", "purpose", "text"],
    "additionalProperties": false
  }
}
