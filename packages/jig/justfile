# ---------------------------------------------------------------------------- #
#                                   COMMANDS                                   #
# ---------------------------------------------------------------------------- #

@default:
    just --list

# Build the installed CLI, inert authoring SDK, and private workers
@build: verify-build-bun clean
    mkdir -p bin libexec/agent libexec/evaluator libexec/preparation
    cp scripts/installed-jig.sh bin/jig
    chmod 755 bin/jig
    bun node_modules/typescript/bin/tsc -p tsconfig.json
    bun build src/index.ts --target=bun --format=esm --outfile=dist/index.js
    bun build src/installed-cli.ts --target=bun --format=esm --outfile=libexec/installed-cli.js
    bun build src/internal/linux-rootless-supervisor.ts --target=bun --format=esm --outfile=libexec/linux-rootless-supervisor.js
    bun build src/internal/project-evaluator-worker.ts --target=bun --format=esm --outfile=libexec/evaluator/project-evaluator-worker.js
    bun build src/internal/openai-agent-worker.ts --target=bun --format=esm --outfile=libexec/agent/openai-agent-worker.js
    bun build src/internal/codex-agent-launcher.ts --target=bun --format=esm --outfile=libexec/agent/codex-agent-launcher.js
    cp node_modules/@agentclientprotocol/codex-acp/dist/index.js libexec/agent/codex-acp.js
    cp node_modules/@agentclientprotocol/codex-acp/LICENSE libexec/agent/codex-acp.LICENSE
    cp support/codex-requirements.toml libexec/agent/codex-requirements.toml
    bun build src/internal/claude-agent-launcher.ts --target=bun --format=esm --outfile=libexec/agent/claude-agent-launcher.js
    bun build node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js --target=bun --format=esm --outfile=libexec/agent/claude-agent-acp.js
    cp node_modules/@agentclientprotocol/claude-agent-acp/LICENSE libexec/agent/claude-agent-acp.LICENSE
    cp node_modules/@anthropic-ai/claude-agent-sdk/LICENSE.md libexec/agent/claude-agent-sdk.LICENSE
    bun build src/internal/pi-agent-launcher.ts --target=bun --format=esm --outfile=libexec/agent/pi-agent-launcher.js
    bun build node_modules/pi-acp/dist/index.js --target=bun --format=esm --outfile=libexec/agent/pi-acp.js
    cp node_modules/pi-acp/LICENSE libexec/agent/pi-acp.LICENSE
    bun build src/internal/bun-native-preparation-worker.ts --target=bun --format=esm --outfile=libexec/preparation/bun-native-preparation-worker.js
    bun build src/project/evaluator-sdk-entry.ts --target=bun --format=esm --outfile=libexec/evaluator/project-evaluator-sdk.bundle.js
    cp ../../docs/jig/spec/machine/project-authoring-1.schema.json libexec/evaluator/project-authoring-1.schema.json
    cp node_modules/openai/LICENSE libexec/agent/openai.LICENSE

# Remove only generated package output
clean:
    #!/usr/bin/env bun
    import { rm } from 'node:fs/promises';
    for (const path of ['dist', 'bin', 'libexec']) {
      await rm(path, { recursive: true, force: true });
    }

# Build, then pack; release publication reuses an already tested archive
[positional-arguments]
@pack *args: build
    bun pm pack --ignore-scripts "$@"

# ---------------------------------------------------------------------------- #
#                                    CHECKS                                    #
# ---------------------------------------------------------------------------- #

# Reject a different build runtime before touching generated output
verify-build-bun:
    #!/usr/bin/env bun
    if (Bun.version !== '1.3.3' || Bun.revision !== '274e01c737e85f8142070a9745b43a2ba09fce4c') {
      throw new Error('Jig must be built with exact Bun 1.3.3 revision 274e01c737e85f8142070a9745b43a2ba09fce4c');
    }

[positional-arguments]
@test *args:
    bun test "$@"

check: build test

# Build and test the installed package in a clean external consumer
@test-package: build
    bun test/package-smoke.ts

# Run sequentially, only inside an already provisioned delegated proof host
@test-linux-rootless-proof-host: build
    JIG_LINUX_ROOTLESS_HOSTILE=1 bun test test/linux-rootless-delegation-hostile.test.ts --timeout 30000
    JIG_LINUX_ROOTLESS_HOSTILE=1 bun test test/linux-rootless-run.test.ts --timeout 30000
    JIG_LINUX_ROOTLESS_HOSTILE=1 bun test test/bun-native-preparation.test.ts --timeout 120000
    JIG_LINUX_ROOTLESS_HOSTILE=1 bun test test/private-foreground.test.ts --timeout 30000
    JIG_LINUX_ROOTLESS_HOSTILE=1 bun test test/root-agent-run-lifecycle.test.ts --timeout 180000
