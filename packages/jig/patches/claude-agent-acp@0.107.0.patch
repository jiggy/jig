@@ -65,6 +65,10 @@ export class AuthStatusReporter {
             return;
         }
         this.current = next;
+        // Jig owns credential selection. Authentication-status pushes are outside its finite ACP exchange.
+        if (process.env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC === "1") {
+            return;
