+    /** Require acknowledgement from the current query for each Jig prompt. */
+    confirmReviewedReasoningEffort(value) {
+        return this.serialized(async () => {
+            if (this.effort.pinned !== value || this.effort.applied !== value)
+                return false;
+            await this.session.query.applyFlagSettings(effortFlagSettings(value, this.ultracodeEnabled));
+            return true;
+        });
+    }
