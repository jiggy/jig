@default:
    just --list

@build:
    rm -rf dist
    bun node_modules/typescript/bin/tsc -p tsconfig.json
    cp src/reporting.json dist/reporting.json
    cp LICENSE dist/LICENSE

[positional-arguments]
@test *args:
    bun test "$@"

check: build test test-node

[positional-arguments]
@pack *args: build
    bun pm pack --ignore-scripts "$@"

# Exercise actual public SDK protocol pipes and material snapshots under Node.
test-node: build
    node --test test/*.node.mjs
