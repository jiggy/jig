@default:
    just --list

@build-jig: test-landing
    bun node_modules/@rspress/core/bin/rspress.js build -c jig/rspress.config.ts

@test-landing:
    node --test jig/landing-tests/*.cjs

[positional-arguments]
@dev-jig *args:
    bun node_modules/@rspress/core/bin/rspress.js dev -c jig/rspress.config.ts "$@"

[positional-arguments]
dev *args:
    bun node_modules/@rspress/core/bin/rspress.js dev -c jig/rspress.config.ts "$@"
