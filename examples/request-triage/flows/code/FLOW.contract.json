{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-1.schema.json",
  "outcomes": {
    "blocked": "The selected method cannot classify the request.",
    "limit": "The selected method reaches its execution limit."
  },
  "input": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": ["message"],
    "additionalProperties": false
  },
  "result": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "done"
          },
          "output": {
            "type": "object",
            "properties": {
              "queue": {
                "type": "string",
                "enum": ["billing", "technical", "manual"]
              }
            },
            "required": ["queue"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": ["blocked", "limit"]
          },
          "output": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": ["reason"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      }
    ]
  }
}
