{
  "attachments": {
    "files": "read-write"
  },
  "input": {
    "type": "object",
    "properties": {
      "status": {
        "enum": ["ready", "needs_mapping"]
      },
      "reason": {
        "type": "string"
      },
      "mapping": {
        "type": ["object", "null"],
        "properties": {
          "name": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "email": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "organization": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        },
        "required": ["name", "email", "organization"],
        "additionalProperties": false
      },
      "accepted": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "record": {
              "type": "integer"
            },
            "contact": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "organization": {
                  "type": "string"
                }
              },
              "required": ["name", "email", "organization"],
              "additionalProperties": false
            }
          },
          "required": ["record", "contact"],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "rejected": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "record": {
              "type": "integer"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": ["record", "reason"],
          "additionalProperties": false
        },
        "maxItems": 100
      }
    },
    "required": ["status", "reason", "mapping", "accepted", "rejected"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "outcome": {
        "const": "done"
      },
      "output": {
        "type": "object",
        "properties": {
          "file": {
            "const": "preview.json"
          },
          "status": {
            "enum": ["ready", "needs_mapping"]
          },
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "rejected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["file", "status", "accepted", "rejected"],
        "additionalProperties": false
      }
    },
    "required": ["outcome", "output"],
    "additionalProperties": false
  },
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "channels": {
    "progress": {
      "direction": "send",
      "delivery": "broadcast",
      "required": false,
      "contract": "./contracts/reporting/reporting.json"
    }
  }
}
