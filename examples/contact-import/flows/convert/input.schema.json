{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "headers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "maxItems": 16,
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 2048
        },
        "maxItems": 16
      },
      "maxItems": 100
    },
    "mapping": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "email": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "organization": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      },
      "required": [
        "name",
        "email",
        "organization"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "headers",
    "rows",
    "mapping"
  ],
  "additionalProperties": false
}
