{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "done"
        },
        "output": {
          "type": "object",
          "properties": {
            "mapping": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "name": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "email": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "organization": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                }
              },
              "required": [
                "name",
                "email",
                "organization"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mapping"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "outcome",
        "output"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "blocked",
            "limit"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "outcome",
        "output"
      ],
      "additionalProperties": false
    }
  ]
}
