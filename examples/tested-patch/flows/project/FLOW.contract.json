{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "outcomes": {
    "blocked": "The defect was not reproduced or no acceptable patch was produced.",
    "limit": "The Agent stopped at its limit."
  },
  "attachments": {
    "source": "read",
    "deliverables": "read-write"
  },
  "channels": {
    "progress": {
      "direction": "send",
      "required": false,
      "schema": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["baseline", "proposal", "check", "finished"]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": ["phase", "attempt"],
        "additionalProperties": false
      }
    },
    "updates": {
      "direction": "send",
      "delivery": "broadcast",
      "required": false,
      "contract": "./contracts/reporting/reporting.json"
    }
  },
  "input": {
    "type": "object",
    "properties": {
      "issue": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "editPaths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "checks": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "required": ["issue", "editPaths"],
    "additionalProperties": false
  }
}
