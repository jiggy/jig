{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "input": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "result": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": ["done"]
          },
          "output": {
            "type": "object",
            "properties": {
              "status": {
                "enum": ["ready"]
              },
              "count": {
                "type": "integer",
                "minimum": 8,
                "maximum": 8
              },
              "roster": {
                "enum": ["schedule/roster.csv"]
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "shiftId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1439
                    },
                    "until": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440
                    },
                    "role": {
                      "enum": ["cook", "serve"]
                    },
                    "volunteerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    }
                  },
                  "required": ["shiftId", "from", "until", "role", "volunteerId", "name"],
                  "additionalProperties": false
                },
                "minItems": 8,
                "maxItems": 8
              }
            },
            "required": ["status", "count", "roster", "rows"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": ["blocked"]
          },
          "output": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": ["reason"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": ["limit"]
          },
          "output": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": ["reason"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      }
    ]
  },
  "channels": {
    "progress": {
      "direction": "send",
      "delivery": "broadcast",
      "required": false,
      "contract": "./contracts/reporting/reporting.json"
    }
  },
  "attachments": {
    "source": "read"
  },
  "artifactResults": ["schedule"],
  "outcomes": {
    "blocked": "The scenario is uncovered or a complete roster needs review.",
    "limit": "The Agent reaches its configured limit."
  }
}
