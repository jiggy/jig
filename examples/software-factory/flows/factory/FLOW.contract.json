{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "outcomes": {
    "blocked": "At least one job was unrouted or unsuccessful, or accepted patches conflict."
  },
  "input": {
    "type": "object",
    "properties": {
      "jobs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "description": "Distinct lowercase job ID; the Flow validates the allowed characters."
            },
            "directory": {
              "type": "string",
              "maxLength": 256,
              "description": "Relative source directory with slash-separated safe path segments; the Flow validates path syntax and depth."
            },
            "checks": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "description": "Name of a bundled acceptance-case set; the Flow validates the allowed characters and existence."
            },
            "issue": { "type": "string", "minLength": 1, "maxLength": 8000 },
            "editPaths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "description": "Path to an existing TypeScript or JavaScript source file under src/; the Flow validates it against the captured project."
              }
            },
            "method": { "enum": ["p1", "p2"] },
            "cancelAfterMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
          },
          "required": ["id", "directory", "checks", "issue", "editPaths"],
          "additionalProperties": false
        }
      }
    },
    "required": ["jobs"],
    "additionalProperties": false
  },
  "channels": {
    "progress": {
      "direction": "send",
      "required": false,
      "delivery": "broadcast",
      "schema": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string", "minLength": 1, "maxLength": 32 },
          "phase": {
            "type": "string",
            "enum": [
              "selecting",
              "invoking",
              "baseline",
              "proposal",
              "check",
              "finished",
              "settled"
            ]
          },
          "attempt": { "type": "integer", "minimum": 0, "maximum": 2 },
          "method": { "type": "string", "enum": ["p1", "p2"] },
          "status": { "type": "string", "enum": ["review-ready", "unsuccessful", "unrouted"] }
        },
        "required": ["jobId", "phase", "attempt"],
        "additionalProperties": false
      }
    }
  },
  "attachments": {
    "source": "read",
    "deliverables": "read-write"
  }
}
