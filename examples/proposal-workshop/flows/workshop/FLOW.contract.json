{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-1.schema.json",
  "input": {
    "type": "object",
    "properties": {
      "objective": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": ["id", "description"],
          "additionalProperties": false
        },
        "maxItems": 16,
        "minItems": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": ["id", "url", "text"],
          "additionalProperties": false
        },
        "maxItems": 32,
        "minItems": 1
      }
    },
    "required": ["objective", "requirements", "evidence"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "outcome": {
        "enum": ["done", "blocked", "limit"]
      },
      "output": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "proposal": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "sections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "requirementId": {
                          "type": "string"
                        },
                        "claim": {
                          "type": "string"
                        },
                        "citationIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "maxItems": 32
                        }
                      },
                      "required": ["requirementId", "claim", "citationIds"],
                      "additionalProperties": false
                    },
                    "maxItems": 16
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 16
                  }
                },
                "required": ["title", "sections", "limitations"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": ["approve", "revise", "blocked"]
                  },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 16
                  }
                },
                "required": ["verdict", "issues"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "feedback": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 128
                },
                "verdict": {
                  "enum": ["approve", "revise", "blocked", "limit", "mechanical-check-failed"]
                }
              },
              "required": ["attempt", "feedback", "verdict"],
              "additionalProperties": false
            },
            "maxItems": 2
          },
          "markdown": {
            "type": "string"
          }
        },
        "required": ["reason", "proposal", "review", "attempts", "history", "markdown"],
        "additionalProperties": false
      }
    },
    "required": ["outcome", "output"],
    "additionalProperties": false
  },
  "outcomes": {
    "blocked": "A specialist cannot produce or approve a proposal from the supplied evidence.",
    "limit": "A specialist or the workshop's one-revision budget is exhausted."
  }
}
