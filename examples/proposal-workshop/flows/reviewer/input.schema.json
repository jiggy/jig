{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 16,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "id",
              "url",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "minItems": 1
        }
      },
      "required": [
        "objective",
        "requirements",
        "evidence"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "citationIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              }
            },
            "required": [
              "requirementId",
              "claim",
              "citationIds"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        }
      },
      "required": [
        "title",
        "sections",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "request",
    "proposal"
  ],
  "additionalProperties": false
}
