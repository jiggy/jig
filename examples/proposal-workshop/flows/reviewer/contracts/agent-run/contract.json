{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-1.schema.json",
  "id": "https://jig.md/contracts/agent-run",
  "version": "1.0.0",
  "input": {
    "$ref": "#/$defs/RunInput"
  },
  "result": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "done"
          },
          "output": {
            "$ref": "#/$defs/AgentOutput"
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "blocked"
          },
          "output": {
            "$ref": "#/$defs/AgentOutput"
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "limit"
          },
          "output": {
            "$ref": "#/$defs/AgentOutput"
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      }
    ]
  },
  "outcomes": {
    "blocked": "The Agent completed its bounded response but reported that the requested work is blocked.",
    "limit": "The Agent completed its bounded response but reported an Agent limit; host deadline and cancellation remain operational failures."
  },
  "channels": {
    "events": {
      "direction": "send",
      "required": false,
      "contract": "./contracts/acp-public-updates.json"
    }
  },
  "$defs": {
    "RunInput": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "skills": {
          "$ref": "#/$defs/SkillContents"
        },
        "responseSchema": {
          "type": "object"
        },
        "guidance": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["label", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["instructions"],
      "additionalProperties": false
    },
    "AgentOutput": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 8388608
        },
        "structured": true
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "SkillContents": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "files": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "text": {
                  "type": "string",
                  "maxLength": 1048576
                }
              },
              "required": ["path", "text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "files"],
        "additionalProperties": false
      }
    }
  }
}
