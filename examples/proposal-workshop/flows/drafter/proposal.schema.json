{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "citationIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          }
        },
        "required": ["requirementId", "claim", "citationIds"],
        "additionalProperties": false
      },
      "maxItems": 16
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    }
  },
  "required": ["title", "sections", "limitations"],
  "additionalProperties": false
}
