{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "done"
        },
        "output": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "requirementId": {
                    "type": "string"
                  },
                  "claim": {
                    "type": "string"
                  },
                  "citationIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32
                  }
                },
                "required": [
                  "requirementId",
                  "claim",
                  "citationIds"
                ],
                "additionalProperties": false
              },
              "maxItems": 16
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 16
            }
          },
          "required": [
            "title",
            "sections",
            "limitations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "outcome",
        "output"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "blocked",
            "limit"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "outcome",
        "output"
      ],
      "additionalProperties": false
    }
  ]
}
