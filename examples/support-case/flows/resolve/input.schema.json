{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "charges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "invoiceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "amountCents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "status": {
                "enum": [
                  "settled",
                  "refunded"
                ]
              }
            },
            "required": [
              "id",
              "invoiceId",
              "amountCents",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "charges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "message",
    "account"
  ],
  "additionalProperties": false
}
