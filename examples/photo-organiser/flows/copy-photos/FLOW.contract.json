{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "attachments": {
    "source": "read",
    "files": "read-write"
  },
  "input": {
    "type": "object",
    "properties": {
      "assignments": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "event": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          },
          "required": ["id", "event"],
          "additionalProperties": false
        }
      }
    },
    "required": ["assignments"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "outcome": {
        "enum": ["done"]
      },
      "output": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "photos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 69
                },
                "date": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 10
                },
                "caption": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "event": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                },
                "destination": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 146
                }
              },
              "required": ["id", "file", "date", "caption", "event", "destination"],
              "additionalProperties": false
            }
          },
          "manifest": {
            "enum": ["manifest.csv"]
          }
        },
        "required": ["count", "photos", "manifest"],
        "additionalProperties": false
      }
    },
    "required": ["outcome", "output"],
    "additionalProperties": false
  },
  "channels": {
    "progress": {
      "direction": "send",
      "delivery": "broadcast",
      "required": false,
      "contract": "./contracts/reporting/reporting.json"
    }
  }
}
