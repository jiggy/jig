{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "attachments": {
    "source": "read",
    "files": "read-write"
  },
  "input": {
    "type": "object",
    "properties": {
      "assignments": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "event": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          },
          "required": ["id", "event"],
          "additionalProperties": false
        }
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": ["assignments", "title"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "outcome": {
        "enum": ["done"]
      },
      "output": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "pages": {
            "type": "integer",
            "minimum": 5,
            "maximum": 27
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "file": {
            "const": "yearbook.pdf"
          }
        },
        "required": ["count", "pages", "bytes", "file"],
        "additionalProperties": false
      }
    },
    "required": ["outcome", "output"],
    "additionalProperties": false
  },
  "channels": {
    "progress": {
      "direction": "send",
      "delivery": "broadcast",
      "required": false,
      "contract": "./contracts/reporting/reporting.json"
    }
  }
}
