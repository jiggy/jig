{
  "$schema": "https://flow.jig.md/schemas/invocation-contract-0.schema.json",
  "outcomes": {
    "blocked": "The Agent cannot propose groups.",
    "limit": "The Agent reaches its limit."
  },
  "input": {
    "type": "object",
    "properties": {
      "photos": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "date": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": ["id", "date", "caption"],
          "additionalProperties": false
        }
      }
    },
    "required": ["photos"],
    "additionalProperties": false
  },
  "result": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "done"
          },
          "output": {
            "type": "object",
            "properties": {
              "assignments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "event"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["assignments"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": ["blocked", "limit"]
          },
          "output": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": ["reason"],
            "additionalProperties": false
          }
        },
        "required": ["outcome", "output"],
        "additionalProperties": false
      }
    ]
  },
  "channels": {
    "progress": {
      "direction": "send",
      "delivery": "broadcast",
      "required": false,
      "contract": "./contracts/reporting/reporting.json"
    }
  }
}
