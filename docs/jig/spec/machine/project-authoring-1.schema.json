{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "title": "Jig project authoring value/1",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/bindingDefinition"
    }
  ],
  "$defs": {
    "localName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "targetSelector": {
      "type": "string",
      "description": "An exact flow:<path>, npm:<package>, binding:<id>, or grant:<name> selector. Prefixes and canonical identities are additionally validated by Jig.",
      "minLength": 5,
      "maxLength": 1029
    },
    "defaultSelector": {
      "type": "string",
      "description": "An exact flow:<path>, npm:<package> or binding:<id> selecting an ordinary implementation with an offered named contract. Jig additionally validates selector grammar, canonical identity and provider eligibility.",
      "minLength": 5,
      "maxLength": 1029
    },
    "discoverSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "discover"
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectPath"
          },
          "minItems": 1,
          "maxItems": 65536
        }
      },
      "required": ["kind", "roots"],
      "additionalProperties": false
    },
    "membersSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "members"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectPath"
          },
          "maxItems": 65536
        }
      },
      "required": ["kind", "paths"],
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/discoverSource"
        },
        {
          "$ref": "#/$defs/membersSource"
        }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "flows": {
          "$ref": "#/$defs/source"
        },
        "bindings": {
          "$ref": "#/$defs/source"
        },
        "grants": {
          "$ref": "#/$defs/source"
        },
        "defaultProviders": {
          "type": "object",
          "description": "Exact contract ID to implementation selector. Each target must offer that named contract; review checks exact identity and resolves only omitted named slots.",
          "additionalProperties": {
            "$ref": "#/$defs/defaultSelector"
          },
          "maxProperties": 256
        }
      },
      "additionalProperties": false
    },
    "packageBinding": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "package"
        },
        "package": {
          "$ref": "#/$defs/projectPath"
        },
        "settings": {
          "type": "object",
          "maxProperties": 65536
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/targetSelector"
              },
              {
                "$ref": "#/$defs/grantPolicy"
              }
            ]
          },
          "maxProperties": 256
        },
        "attachments": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "$ref": "#/$defs/projectPath"
          }
        }
      },
      "required": ["kind", "package", "settings", "slots"],
      "additionalProperties": false
    },
    "bindingDefinition": {
      "$ref": "#/$defs/packageBinding"
    },
    "grantPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "acp" },
            "client": { "enum": ["codex", "claude", "pi"] },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,255}(?![\\s\\S])"
            }
          },
          "required": ["kind", "client"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "http"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "method": {
              "enum": ["GET", "POST"]
            },
            "bearerEnv": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "requestBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "responseBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12582912
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "bodySchema": {
              "type": ["object", "boolean"]
            }
          },
          "required": ["kind", "url", "method", "requestBytes", "responseBytes", "timeoutMs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "command"
            },
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["kind", "run"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "command"
            },
            "test": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": ["kind", "test"],
          "additionalProperties": false
        }
      ]
    }
  }
}
