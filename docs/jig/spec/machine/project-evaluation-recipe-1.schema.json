{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jig.md/schemas/project-evaluation-recipe-1.schema.json",
  "type": "object",
  "properties": {
    "family": { "const": "bun-typescript" },
    "generate": { "$ref": "#/$defs/Source" },
    "test": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/Path" }, { "pattern": "\\.test\\.(ts|js)$" }] },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "collect": {
      "type": "array",
      "items": { "enum": ["generated", "dist", "reports"] },
      "maxItems": 3,
      "uniqueItems": true,
      "default": ["generated", "dist", "reports"]
    }
  },
  "required": ["family", "test"],
  "additionalProperties": false,
  "$defs": {
    "Path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
      "not": { "pattern": "(^|/)\\.?\\.?(/|$)|//|^(?:[^/]+/){16}" }
    },
    "Source": { "allOf": [{ "$ref": "#/$defs/Path" }, { "pattern": "\\.(ts|js)$" }] }
  }
}
