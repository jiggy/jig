{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "title": "Jig lock/1",
  "description": "The portable desired-state value stored as canonical JSON/1 plus LF in jig.lock. Project-path, LocalName, digest, collision, protected-path, aggregate-target, and canonical-byte rules are additionally enforced by Jig.",
  "type": "object",
  "properties": {
    "packages": {
      "type": "object",
      "description": "Package entries keyed by canonical project-relative package path.",
      "additionalProperties": {
        "$ref": "#/$defs/package"
      },
      "maxProperties": 65536
    },
    "bindings": {
      "type": "object",
      "description": "Binding entries keyed by LocalName.",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "maxProperties": 4096
    }
  },
  "required": ["packages", "bindings"],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "description": "A sha256: digest containing exactly 64 lowercase hexadecimal digits.",
      "minLength": 71,
      "maxLength": 71
    },
    "package": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "directRun": {
          "type": "boolean"
        },
        "uses": {
          "type": "object",
          "description": "Invocation requirements keyed by package-local slot: an empty uncontracted requirement or an exact named interface. This is not native-host qualification.",
          "additionalProperties": {
            "$ref": "#/$defs/invocationRequirement"
          },
          "maxProperties": 256
        }
      },
      "required": ["digest", "directRun", "uses"],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "packagePath": {
          "type": "string",
          "description": "A canonical project-relative path selecting one package entry.",
          "minLength": 1,
          "maxLength": 1024
        },
        "settings": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 65536
        },
        "slots": {
          "type": "object",
          "description": "Exact Flow or leaf Binding identities keyed by consumer-local slot name.",
          "additionalProperties": {
            "$ref": "#/$defs/targetIdentity"
          },
          "maxProperties": 256
        },
        "http": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "maxLength": 64
          }
        },
        "commands": {
          "$ref": "#/$defs/commands"
        },
        "attachments": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": { "$ref": "#/$defs/attachment" }
        }
      },
      "required": ["packagePath", "settings", "slots"],
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "digest": { "$ref": "#/$defs/digest" },
        "files": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512 },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
              "digest": { "$ref": "#/$defs/digest" }
            },
            "required": ["path", "bytes", "digest"],
            "additionalProperties": false
          }
        }
      },
      "required": ["source", "digest", "files"],
      "additionalProperties": false
    },
    "targetIdentity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "flow"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "binding"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        }
      ]
    },
    "commands": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": ["run"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "test": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "required": ["test"],
            "additionalProperties": false
          }
        ]
      }
    },
    "invocationRequirement": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": ["id", "version", "digest"],
          "additionalProperties": false
        }
      ]
    }
  }
}
