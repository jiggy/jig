{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "title": "Jig lock/1",
  "description": "The portable desired-state value stored as canonical JSON/1 plus LF in jig.lock. Project-path, LocalName, digest, collision, protected-path, aggregate-target, and canonical-byte rules are additionally enforced by Jig.",
  "type": "object",
  "properties": {
    "packages": {
      "type": "object",
      "description": "Package entries keyed by canonical project-relative package path.",
      "additionalProperties": {
        "$ref": "#/$defs/package"
      },
      "maxProperties": 65536
    },
    "bindings": {
      "type": "object",
      "description": "Binding entries keyed by LocalName.",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "maxProperties": 4096
    }
  },
  "required": [
    "packages",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "description": "A sha256: digest containing exactly 64 lowercase hexadecimal digits.",
      "minLength": 71,
      "maxLength": 71
    },
    "package": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "directRun": {
          "type": "boolean"
        },
        "uses": {
          "type": "object",
          "description": "Exact admitted Capability Contract uses keyed by the package-local slot name.",
          "additionalProperties": {
            "$ref": "#/$defs/capabilityUse"
          },
          "maxProperties": 1
        }
      },
      "required": [
        "digest",
        "directRun",
        "uses"
      ],
      "additionalProperties": false
    },
    "capabilityUse": {
      "type": "object",
      "properties": {
        "id": {
          "const": "https://jig.md/contracts/agent-run"
        },
        "version": {
          "const": "1.0.0"
        },
        "digest": {
          "const": "sha256:5a0f06495323419d275eeff92617d9287647ece137dacc9c5c6d50466d65c0f0"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "packagePath": {
          "type": "string",
          "description": "A canonical project-relative path selecting one package entry.",
          "minLength": 1,
          "maxLength": 1024
        },
        "settings": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 65536
        },
        "slots": {
          "type": "object",
          "description": "Exact Flow or leaf Binding identities keyed by consumer-local slot name.",
          "additionalProperties": {
            "$ref": "#/$defs/targetIdentity"
          },
          "maxProperties": 256
        }
      },
      "required": [
        "packagePath",
        "settings",
        "slots"
      ],
      "additionalProperties": false
    },
    "targetIdentity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "flow" },
            "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "binding" },
            "id": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        }
      ]
    }
  }
}
