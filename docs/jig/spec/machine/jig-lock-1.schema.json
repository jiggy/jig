{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "title": "Jig lock/1",
  "description": "The portable desired-state value stored as canonical JSON/1 plus LF in jig.lock. Project-path, LocalName, digest, collision, protected-path, aggregate-target, and canonical-byte rules are additionally enforced by Jig.",
  "type": "object",
  "properties": {
    "packages": {
      "type": "object",
      "description": "Package entries keyed by canonical project-relative package path.",
      "additionalProperties": {
        "$ref": "#/$defs/package"
      },
      "maxProperties": 65536
    },
    "bindings": {
      "type": "object",
      "description": "Binding entries keyed by LocalName.",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "maxProperties": 4096
    }
  },
  "required": [
    "packages",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "description": "A sha256: digest containing exactly 64 lowercase hexadecimal digits.",
      "minLength": 71,
      "maxLength": 71
    },
    "package": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "directRun": {
          "type": "boolean"
        }
      },
      "required": [
        "digest",
        "directRun"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "packagePath": {
          "type": "string",
          "description": "A canonical project-relative path selecting one package entry.",
          "minLength": 1,
          "maxLength": 1024
        },
        "settings": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 65536
        },
        "slots": {
          "type": "object",
          "description": "Exact child-Flow package paths keyed by consumer-local slot name.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxProperties": 256
        }
      },
      "required": [
        "packagePath",
        "settings",
        "slots"
      ],
      "additionalProperties": false
    }
  }
}
