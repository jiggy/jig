{
  "$schema": "https://flow.jig.md/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://jig.md/contracts/run-checkpoint",
  "version": "1.0.0",
  "methods": {
    "save": {
      "input": {
        "$ref": "#/$defs/Input"
      },
      "output": {
        "$ref": "#/$defs/Receipt"
      },
      "errors": {}
    }
  },
  "$defs": {
    "Input": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "evidence": {},
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1048576
          },
          "maxProperties": 64
        }
      },
      "required": ["sequence", "evidence", "files"],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "digest": {
          "type": "string",
          "maxLength": 71
        }
      },
      "required": ["sequence", "digest"],
      "additionalProperties": false
    }
  }
}
