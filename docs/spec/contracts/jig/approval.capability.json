{
  "$schema": "https://flow.dev/schemas/capability-contract-1.schema.json",
  "flowCapabilityContract": 1,
  "id": "https://jig.dev/contracts/approval",
  "version": "1.0.0",
  "methods": {
    "request": {
      "input": { "$ref": "#/$defs/ApprovalRequest" },
      "output": { "$ref": "#/$defs/ApprovalDecision" },
      "errors": {}
    }
  },
  "$defs": {
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "details": true
      },
      "required": ["approvalId", "kind", "summary", "details"],
      "additionalProperties": false
    },
    "ApprovalDecision": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": ["allow-once", "deny"]
        }
      },
      "required": ["decision"],
      "additionalProperties": false
    }
  }
}
