{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "title": "Private Jig project-Run-target Binding value/1",
  "$ref": "#/$defs/packageBinding",
  "$defs": {
    "localName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "flowRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "flow" },
        "path": { "$ref": "#/$defs/projectPath" }
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    },
    "bindingRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "binding" },
        "id": { "$ref": "#/$defs/localName" }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "runTargetRef": {
      "oneOf": [
        { "$ref": "#/$defs/flowRef" },
        { "$ref": "#/$defs/bindingRef" }
      ]
    },
    "candidateSet": {
      "type": "object",
      "properties": {
        "kind": { "const": "candidates" },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/runTargetRef" },
          "minItems": 2,
          "maxItems": 65536
        }
      },
      "required": ["kind", "targets"],
      "additionalProperties": false
    },
    "projectRunTargets": {
      "type": "object",
      "properties": {
        "kind": { "const": "project-run-targets" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "slotRef": {
      "oneOf": [
        { "$ref": "#/$defs/runTargetRef" },
        { "$ref": "#/$defs/candidateSet" },
        { "$ref": "#/$defs/projectRunTargets" }
      ]
    },
    "packageBinding": {
      "type": "object",
      "properties": {
        "kind": { "const": "package" },
        "package": { "$ref": "#/$defs/projectPath" },
        "settings": { "type": "object", "maxProperties": 65536 },
        "slots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/slotRef" },
          "maxProperties": 65536
        },
        "attachments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/projectPath" },
          "maxProperties": 65536
        }
      },
      "required": ["kind", "package", "settings", "slots", "attachments"],
      "additionalProperties": false
    }
  }
}
