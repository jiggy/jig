{
  "$schema": "https://flow.dev/schemas/schema-1.json",
  "title": "Private Jig project authoring value with Hooks/1",
  "oneOf": [
    { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/bindingDefinition" },
    { "$ref": "#/$defs/hookDefinition" }
  ],
  "$defs": {
    "localName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "discoverSource": {
      "type": "object",
      "properties": {
        "kind": { "const": "discover" },
        "roots": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectPath" },
          "minItems": 1,
          "maxItems": 65536
        }
      },
      "required": ["kind", "roots"],
      "additionalProperties": false
    },
    "membersSource": {
      "type": "object",
      "properties": {
        "kind": { "const": "members" },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectPath" },
          "maxItems": 65536
        }
      },
      "required": ["kind", "paths"],
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/discoverSource" },
        { "$ref": "#/$defs/membersSource" }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "flows": { "$ref": "#/$defs/source" },
        "bindings": { "$ref": "#/$defs/source" },
        "hooks": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "flowRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "flow" },
        "path": { "$ref": "#/$defs/projectPath" }
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    },
    "bindingRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "binding" },
        "id": { "$ref": "#/$defs/localName" }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "runTargetRef": {
      "oneOf": [
        { "$ref": "#/$defs/flowRef" },
        { "$ref": "#/$defs/bindingRef" }
      ]
    },
    "candidateSet": {
      "type": "object",
      "properties": {
        "kind": { "const": "candidates" },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/runTargetRef" },
          "minItems": 2,
          "maxItems": 65536
        }
      },
      "required": ["kind", "targets"],
      "additionalProperties": false
    },
    "slotRef": {
      "oneOf": [
        { "$ref": "#/$defs/runTargetRef" },
        { "$ref": "#/$defs/candidateSet" }
      ]
    },
    "packageBinding": {
      "type": "object",
      "properties": {
        "kind": { "const": "package" },
        "package": { "$ref": "#/$defs/projectPath" },
        "settings": { "type": "object", "maxProperties": 65536 },
        "slots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/slotRef" },
          "maxProperties": 65536
        },
        "attachments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/projectPath" },
          "maxProperties": 65536
        }
      },
      "required": ["kind", "package", "settings", "slots", "attachments"],
      "additionalProperties": false
    },
    "journalPublisher": {
      "type": "object",
      "properties": {
        "kind": { "const": "journal-publisher" },
        "eventTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 65536
        }
      },
      "required": ["kind", "eventTypes"],
      "additionalProperties": false
    },
    "bindingDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/packageBinding" },
        { "$ref": "#/$defs/journalPublisher" }
      ]
    },
    "hookDefinition": {
      "type": "object",
      "properties": {
        "kind": { "const": "hook" },
        "on": {
          "type": "object",
          "properties": {
            "publisher": { "$ref": "#/$defs/bindingRef" },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["publisher", "type"],
          "additionalProperties": false
        },
        "run": { "$ref": "#/$defs/runTargetRef" }
      },
      "required": ["kind", "on", "run"],
      "additionalProperties": false
    }
  }
}
