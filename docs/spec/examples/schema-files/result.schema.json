{
  "$schema": "https://flow.jig.md/schemas/schema-1.json",
  "title": "Gauntlet result",
  "$defs": {
    "doneOutput": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "artifact",
        "score"
      ],
      "additionalProperties": false
    },
    "blockedOutput": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "done"
        },
        "output": {
          "$ref": "#/$defs/doneOutput"
        }
      },
      "required": [
        "outcome",
        "output"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "blocked"
        },
        "output": {
          "$ref": "#/$defs/blockedOutput"
        }
      },
      "required": [
        "outcome",
        "output"
      ],
      "additionalProperties": false
    }
  ]
}