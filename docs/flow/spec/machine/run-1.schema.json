{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow.jig.md/schemas/run-1.json",
  "title": "FLOW Run/1 frames",
  "oneOf": [
    {
      "$ref": "#/$defs/flowRunRequest"
    },
    {
      "$ref": "#/$defs/childFlowRequest"
    },
    {
      "$ref": "#/$defs/capabilityCallRequest"
    },
    {
      "$ref": "#/$defs/requestCancelNotification"
    },
    {
      "$ref": "#/$defs/runSuccessResponse"
    },
    {
      "$ref": "#/$defs/capabilitySuccessResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/channelCreateRequest"
    },
    {
      "$ref": "#/$defs/channelSendRequest"
    },
    {
      "$ref": "#/$defs/channelNextRequest"
    },
    {
      "$ref": "#/$defs/channelCloseRequest"
    },
    {
      "$ref": "#/$defs/channelReleaseRequest"
    },
    {
      "$ref": "#/$defs/channelSuccessResponse"
    }
  ],
  "$defs": {
    "wireId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "maxLength": 128
    },
    "operationId": {
      "$ref": "#/$defs/wireId"
    },
    "localName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "attachment": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": ["read", "read-write"]
        }
      },
      "required": ["path", "access"],
      "additionalProperties": false
    },
    "attachments": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/localName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attachment"
      },
      "maxProperties": 256
    },
    "runResult": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/localName"
        },
        "output": true
      },
      "required": ["outcome", "output"],
      "additionalProperties": false
    },
    "capabilityResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": true
          },
          "required": ["value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/localName"
                },
                "data": true
              },
              "required": ["name", "data"],
              "additionalProperties": false
            }
          },
          "required": ["error"],
          "additionalProperties": false
        }
      ]
    },
    "flowErrorCode": {
      "enum": [
        "CANCELLED",
        "DEADLINE_EXCEEDED",
        "OWNER_CLOSED",
        "OPERATION_CONFLICT",
        "UNAVAILABLE",
        "PERMISSION_DENIED",
        "RESOURCE_EXHAUSTED",
        "INVALID_INPUT",
        "INVALID_RESULT",
        "UNCERTAIN",
        "EXECUTION_FAILED",
        "LAGGED",
        "DISCONNECTED"
      ]
    },
    "flowErrorData": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/flowErrorCode"
        },
        "details": true
      },
      "required": ["code"],
      "additionalProperties": false
    },
    "flowRunParams": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "run/1"
        },
        "input": true,
        "settings": {
          "type": "object"
        },
        "attachments": {
          "$ref": "#/$defs/attachments"
        },
        "scratch": {
          "type": "string",
          "minLength": 1
        },
        "deadlineUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "channels": {
          "$ref": "#/$defs/channelGrants"
        }
      },
      "required": ["protocol", "input", "settings", "attachments", "scratch", "deadlineUnixMs"],
      "additionalProperties": false
    },
    "childFlowParams": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "slot": {
          "$ref": "#/$defs/localName"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "input": true,
        "channels": {
          "$ref": "#/$defs/channelReferences"
        }
      },
      "required": ["operationId", "slot", "input"],
      "additionalProperties": false
    },
    "capabilityCallParams": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "slot": {
          "$ref": "#/$defs/localName"
        },
        "method": {
          "$ref": "#/$defs/localName"
        },
        "input": true,
        "channels": {
          "$ref": "#/$defs/channelReferences"
        }
      },
      "required": ["operationId", "slot", "method", "input"],
      "additionalProperties": false
    },
    "requestCancelParams": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/wireId"
        }
      },
      "required": ["requestId"],
      "additionalProperties": false
    },
    "flowRunRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "flow/run"
        },
        "params": {
          "$ref": "#/$defs/flowRunParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "childFlowRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "flow/run-child"
        },
        "params": {
          "$ref": "#/$defs/childFlowParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "capabilityCallRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "capability/call"
        },
        "params": {
          "$ref": "#/$defs/capabilityCallParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "requestCancelNotification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "request/cancel"
        },
        "params": {
          "$ref": "#/$defs/requestCancelParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "additionalProperties": false
    },
    "runSuccessResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "result": {
          "$ref": "#/$defs/runResult"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "capabilitySuccessResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "result": {
          "$ref": "#/$defs/capabilityResult"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "flowErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "const": -32000
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "data": {
              "$ref": "#/$defs/flowErrorData"
            }
          },
          "required": ["code", "message", "data"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "standardErrorResponse": {
      "oneOf": [
        {
          "$ref": "#/$defs/parseErrorResponse"
        },
        {
          "$ref": "#/$defs/invalidRequestResponse"
        },
        {
          "$ref": "#/$defs/correlatedStandardErrorResponse"
        }
      ]
    },
    "parseErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "const": -32700
            },
            "message": {
              "$ref": "#/$defs/errorMessage"
            },
            "data": true
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "invalidRequestResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/wireId"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "const": -32600
            },
            "message": {
              "$ref": "#/$defs/errorMessage"
            },
            "data": true
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "correlatedStandardErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [-32601, -32602, -32603]
            },
            "message": {
              "$ref": "#/$defs/errorMessage"
            },
            "data": true
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "errorMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "errorResponse": {
      "oneOf": [
        {
          "$ref": "#/$defs/flowErrorResponse"
        },
        {
          "$ref": "#/$defs/standardErrorResponse"
        }
      ]
    },
    "channelContractIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^https://(?!(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])(?:/|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+/(?!\\.{1,2}(?:/|$))[a-z0-9._~-]+(?:/(?!\\.{1,2}(?:/|$))[a-z0-9._~-]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["id", "version", "digest"],
      "additionalProperties": false
    },
    "channelGrant": {
      "oneOf": [
        {
          "$ref": "#/$defs/channelSenderGrant"
        },
        {
          "$ref": "#/$defs/channelReceiverGrant"
        }
      ]
    },
    "channelGrants": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/localName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/channelGrant"
      },
      "maxProperties": 256
    },
    "channelReferences": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/localName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/wireId"
      },
      "maxProperties": 256
    },
    "channelCreateParams": {
      "type": "object",
      "properties": {
        "delivery": {
          "const": "direct"
        },
        "schema": {
          "oneOf": [{ "type": "object" }, { "type": "boolean" }]
        },
        "contract": {
          "type": "string",
          "pattern": "^\\./[^\\\\]+$",
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false,
      "not": {
        "type": "object",
        "properties": {
          "schema": true,
          "contract": true
        },
        "required": ["schema", "contract"]
      }
    },
    "channelEndpointParams": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/wireId"
        }
      },
      "required": ["endpoint"],
      "additionalProperties": false
    },
    "channelSendParams": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/wireId"
        },
        "value": true
      },
      "required": ["endpoint", "value"],
      "additionalProperties": false
    },
    "channelPair": {
      "type": "object",
      "properties": {
        "send": {
          "$ref": "#/$defs/channelSenderGrant"
        },
        "receive": {
          "$ref": "#/$defs/channelReceiverGrant"
        }
      },
      "required": ["send", "receive"],
      "additionalProperties": false
    },
    "channelReadResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "value": true
              },
              "required": ["sequence", "value"],
              "additionalProperties": false
            }
          },
          "required": ["item"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "end": {
              "type": "object",
              "properties": {
                "lastSequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["lastSequence"],
              "additionalProperties": false
            }
          },
          "required": ["end"],
          "additionalProperties": false
        }
      ]
    },
    "channelReleaseResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "released"
            }
          },
          "required": ["status"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ended"
            },
            "lastSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["status", "lastSequence"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "code": {
              "$ref": "#/$defs/flowErrorCode"
            },
            "details": true
          },
          "required": ["status", "code"],
          "additionalProperties": false
        }
      ]
    },
    "channelCreateRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "channel/create"
        },
        "params": {
          "$ref": "#/$defs/channelCreateParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "channelSendRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "channel/send"
        },
        "params": {
          "$ref": "#/$defs/channelSendParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "channelNextRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "channel/next"
        },
        "params": {
          "$ref": "#/$defs/channelEndpointParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "channelCloseRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "channel/close"
        },
        "params": {
          "$ref": "#/$defs/channelEndpointParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "channelReleaseRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "method": {
          "const": "channel/release"
        },
        "params": {
          "$ref": "#/$defs/channelEndpointParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false
    },
    "channelSuccessResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/wireId"
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/channelPair"
            },
            {
              "$ref": "#/$defs/channelReadResult"
            },
            {
              "$ref": "#/$defs/channelReleaseResult"
            }
          ]
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "channelSenderGrant": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/wireId"
        },
        "delivery": {
          "const": "direct"
        },
        "contract": {
          "$ref": "#/$defs/channelContractIdentity"
        },
        "direction": {
          "const": "send"
        }
      },
      "required": ["endpoint", "direction", "delivery"],
      "additionalProperties": false
    },
    "channelReceiverGrant": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/wireId"
        },
        "delivery": {
          "const": "direct"
        },
        "contract": {
          "$ref": "#/$defs/channelContractIdentity"
        },
        "direction": {
          "const": "receive"
        },
        "startSequence": {
          "const": 1
        }
      },
      "required": ["endpoint", "direction", "delivery", "startSequence"],
      "additionalProperties": false
    }
  }
}
